EPITO_IMAGE=epito:server
EPITO_WORKER_IMAGE=epito-document-worker:server
EPITO_PULL_POLICY=build
EPITO_CONTAINER_NAME=epito
EPITO_POSTGRES_CONTAINER_NAME=epito-postgres
EPITO_REDIS_CONTAINER_NAME=epito-redis
EPITO_WORKER_CONTAINER_NAME=epito-document-worker

EPITO_BIND_ADDRESS=0.0.0.0
EPITO_PORT=8063
EPITO_NETWORK=epito
EPITO_BACKEND_NETWORK=epito-backend-internal
EPITO_BASE_DOMAIN=epito.example.pl
EPITO_SUPERVISOR_EMAIL=owner@example.pl

EPITO_DATABASE_NAME=epito_prod
EPITO_POSTGRES_VOLUME=epito-postgres-data
EPITO_REDIS_VOLUME=epito-redis-data

# Ustaw poniższe wartości bezpośrednio w Portainerze.
# Nie zapisuj prawdziwych haseł w tym pliku ani w repozytorium.
EPITO_POSTGRES_ADMIN_PASSWORD=
EPITO_DB_PASSWORD=
EPITO_REDIS_PASSWORD=
EPITO_SUPERVISOR_PASSWORD=
