    "framer-motion": "^13.0.0",
    "iconv-lite": "^0.7.0",
    "ioredis": "6.0.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "pg": "8.22.0",
    "puppeteer": "^25.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
